generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  wechatId      String?  @unique
  email         String?  @unique
  loginNickname String?  @unique
  passwordHash  String?
  nickname      String?
  avatarUrl     String?
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inspirations           Inspiration[]
  inspirationReflections InspirationReflection[]
  inspirationReviewBatches InspirationReviewBatch[]
  inspirationWallLayouts InspirationWallLayout[]
  insights               Insight[]
  insightGenerationRuns  InsightGenerationRun[]
  tasks                  Task[]
  pomodoroSessions       PomodoroSession[]
  calendarEvents         CalendarEvent[]
  aiConversations        AIConversation[]
  planningThreads        PlanningThread[]
  pushSubscriptions      PushSubscription[]
  notificationDeliveries NotificationDelivery[]
  courses                Course[]
  courseNotes            CourseNote[]
  semesters              Semester[]
  googleToken            GoogleToken?
  authSessions           AuthSession[]
  schedulePlans          SchedulePlan[]
  courseImportBatches    CourseImportBatch[]
  studyFolders           StudyFolder[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthRateLimit {
  requestKey      String
  action          String
  windowStartedAt DateTime @db.Timestamptz(6)
  attemptCount    Int      @default(1)

  @@id([requestKey, action, windowStartedAt])
  @@index([windowStartedAt])
  @@map("auth_rate_limits")
}

model Semester {
  id        String   @id @default(uuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  weeks     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("semesters")
}

model Inspiration {
  id             String    @id @default(uuid())
  userId         String
  sourceUrl      String?
  sourceType     String    @default("manual")
  title          String?
  description    String?
  contentText    String?   @db.Text
  coverImage     String?
  author         String?
  publishedAt    DateTime?
  aiSummary      String?   @db.Text
  aiInsights     Json      @default("[]")
  tags           String[]
  status         String    @default("active")
  reviewState    String    @default("pending")
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)
  captureRequestId String?
  focusSessionId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?
  reflections  InspirationReflection[]
  insightLinks InsightInspiration[]
  attachments InspirationAttachment[]
  reviewBatchItems InspirationReviewBatchItem[]
  wallLayouts InspirationWallLayout[]
  focusSession PomodoroSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)

  @@unique([userId, captureRequestId])
  @@index([userId])
  @@index([status])
  @@index([tags])
  @@index([userId, nextReviewAt])
  @@index([focusSessionId])
  @@map("inspirations")
}

model InspirationAttachment {
  id            String   @id @default(uuid())
  inspirationId String
  kind          String
  mimeType      String
  originalName  String?
  storageKey    String   @unique
  sizeBytes     Int
  transcript    String?  @db.Text
  aiSummary     String?  @db.Text
  createdAt     DateTime @default(now())

  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@index([inspirationId, createdAt])
  @@map("inspiration_attachments")
}

model InspirationReflection {
  id            String   @id @default(uuid())
  userId        String
  inspirationId String
  body          String   @db.Text
  clientRequestId String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([inspirationId, createdAt])
  @@map("inspiration_reflections")
}

model InspirationReviewBatch {
  id        String   @id @default(uuid())
  userId    String
  localDate String
  timeZone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InspirationReviewBatchItem[]

  @@unique([userId, localDate])
  @@index([userId, createdAt])
  @@map("inspiration_review_batches")
}

model InspirationReviewBatchItem {
  id                String   @id @default(uuid())
  batchId           String
  inspirationId     String
  ordinal           Int
  state             String   @default("pending")
  processedAt       DateTime?
  processedRequestId String?
  resultReflectionId String?
  createdAt         DateTime @default(now())

  batch       InspirationReviewBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  inspiration Inspiration            @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@unique([batchId, inspirationId])
  @@unique([batchId, ordinal])
  @@unique([batchId, processedRequestId])
  @@index([inspirationId])
  @@index([batchId, state])
  @@map("inspiration_review_batch_items")
}


model InspirationWallLayout {
  id            String   @id @default(uuid())
  userId        String
  inspirationId String
  x             Float
  y             Float
  width         Float    @default(176)
  height        Float    @default(156)
  z             Int      @default(0)
  color         String   @default("#f2f0e8")
  rotation      Float    @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@unique([userId, inspirationId])
  @@index([userId, z])
  @@index([inspirationId])
  @@map("inspiration_wall_layouts")
}

model Insight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String   @db.Text
  type      String
  status    String   @default("active")
  aiModel   String?
  generationRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationRun InsightGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  sources InsightInspiration[]
  tasks   Task[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([generationRunId])
  @@map("insights")
}

model InsightGenerationRun {
  id           String    @id @default(uuid())
  userId       String
  runKey       String
  trigger      String    @default("automatic")
  cadence      String
  timeZone     String
  periodStart  DateTime
  periodEnd    DateTime
  scheduledFor DateTime
  status       String    @default("queued")
  sourceCount  Int       @default(0)
  insightCount Int       @default(0)
  retryCount   Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  insights Insight[]

  @@unique([userId, runKey])
  @@index([userId, createdAt])
  @@index([status, scheduledFor])
  @@map("insight_generation_runs")
}

model InsightInspiration {
  insightId     String
  inspirationId String

  insight     Insight     @relation(fields: [insightId], references: [id], onDelete: Cascade)
  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@id([insightId, inspirationId])
  @@index([inspirationId])
  @@map("insight_inspirations")
}

model Task {
  title           String
  description     String?
  status          String    @default("todo")
  priority        String    @default("medium")
  section         String?   @default("personal") // RENAMED from 'column'
  project         String?
  notes           Json?     @default("[]")
  dueDate         DateTime?
  reminderAt      DateTime?
  repeatRule      String?
  repeatStartDate DateTime?
  repeatEndDate   DateTime?
  scheduleLocked  Boolean   @default(false)
  scheduleSource  String    @default("manual")
  scheduleColor   String?

  id               String    @id @default(uuid())
  userId           String
  inspirationId    String?   @unique
  insightId         String?
  estimatedMinutes Int?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  tags             String[]
  aiFeasibility    Json?
  courseId         String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions PomodoroSession[]
  calendarEvents   CalendarEvent[]
  inspiration      Inspiration?      @relation(fields: [inspirationId], references: [id], onDelete: SetNull)
  insight          Insight?          @relation(fields: [insightId], references: [id], onDelete: SetNull)
  course           Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studyFolders     StudyFolderTask[]

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([courseId])
  @@index([insightId])
  @@map("tasks")
}

model PomodoroSession {
  id                String    @id @default(uuid())
  userId            String
  taskId            String?
  duration          Int       @default(25)
  plannedDurationSeconds Int   @default(1500)
  effectiveDurationSeconds Int @default(0)
  pausedDurationSeconds Int    @default(0)
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  lastResumedAt      DateTime?
  pausedAt           DateTime?
  status             String    @default("active") // active/paused/completed/interrupted
  interruptionCount Int       @default(0)
  revision           Int       @default(1)
  clientRequestId    String?
  notes              String?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  segments      PomodoroSegment[]
  calendarEvent CalendarEvent?
  inspirations  Inspiration[]

  @@index([userId])
  @@index([taskId])
  @@unique([userId, clientRequestId])
  @@map("pomodoro_sessions")
}

model PomodoroSegment {
  id        String   @id @default(uuid())
  sessionId String
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime @default(now())

  session PomodoroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
  @@map("pomodoro_segments")
}

model CalendarEvent {
  id                  String    @id @default(uuid())
  userId              String
  taskId              String?
  courseId            String?
  focusSessionId      String?   @unique
  title               String
  eventType           String    @default("task") // task/focus/meeting/reminder/course
  startTime           DateTime
  endTime             DateTime
  isAllDay            Boolean   @default(false)
  recurrenceRule      String?
  isOverride            Boolean   @default(false) // 是否为具体 occurrence 的例外
  overrideType          String?   // reschedule / cancel / swap / extra
  overrideOriginalStart DateTime? // 被覆盖的原始 occurrence 开始时间
  overrideGroupId       String?   // swap 等成组变动的关联 id
  color                 String    @default("#185FA5")
  location            String?
  externalSource      String?
  externalEventId     String?
  sourceCalendarTitle String?
  googleEventId       String?
  googleSyncedAt      DateTime?
  syncStatus          String    @default("pending")
  scheduleLocked      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  focusSession PomodoroSession? @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, externalSource, externalEventId])
  @@index([userId])
  @@index([startTime])
  @@index([courseId])
  @@index([taskId], map: "calendar_events_task_id_idx")
  @@index([userId, overrideGroupId])
  @@map("calendar_events")
}

model PlanningThread {
  id          String   @id @default(uuid())
  userId      String
  title       String?
  scopeType   String   @default("general")
  scopeId     String?
  status      String   @default("active")
  brief       Json     @default("[]")
  constraints Json     @default("[]")
  preferences Json     @default("[]")
  strategy    Json     @default("[]")
  assumptions Json     @default("[]")
  evidence    Json     @default("[]")
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations AIConversation[]
  schedulePlans SchedulePlan[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([scopeType, scopeId])
  @@map("planning_threads")
}

model AIConversation {
  id               String   @id @default(uuid())
  userId           String
  planningThreadId String?
  conversationType String
  userMessage      String
  aiResponse       String   @db.Text
  context          Json?
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planningThread PlanningThread? @relation(fields: [planningThreadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationType])
  @@index([planningThreadId, createdAt])
  @@map("ai_conversations")
}

model SchedulePlan {
  id               String   @id @default(uuid())
  userId           String
  planType         String   @default("task")
  planningThreadId       String?
  planningThreadRevision Int?
  status                 String   @default("applied")
  beforeState      Json
  afterState       Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planningThread PlanningThread? @relation(fields: [planningThreadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, planType, createdAt])
  @@index([planningThreadId, createdAt])
  @@map("schedule_plans")
}

model Course {
  id         String  @id @default(uuid())
  userId     String
  semesterId String?
  name       String
  teacher    String?
  room       String?
  color      String  @default("#b0a8db")

  // 课程规则模板（换课时修改这些字段）
  dayOfWeek Int? // 1=Mon..7=Sun
  startTime String? // "08:00"
  endTime   String? // "09:40"
  weeks     Json?   @default("[]") // [1,2,3,...] 或 {"type":"all"} 或 {"type":"odd"}
  location  String? // 校区/教学楼

  // ICS 来源
  icsUid String? @unique

  // 教务/文件导入来源。稳定指纹用于预览、同步及重复检测。
  sourceType        String?
  sourceSchoolId    String?
  sourceTermId      String?
  sourceEntryId     String?
  sourceFingerprint String?
  importBatchId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    Semester?          @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  events      CalendarEvent[]
  tasks       Task[]
  notes       CourseNote[]
  importBatch CourseImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  studyFolders StudyFolderCourse[]

  @@index([userId])
  @@index([userId, semesterId])
  @@index([semesterId], map: "courses_semester_id_idx")
  @@index([userId, semesterId, sourceFingerprint])
  @@index([importBatchId])
  @@map("courses")
}

model StudyFolder {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  icon        String   @default("book-open")
  color       String   @default("#cae393")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses StudyFolderCourse[]
  tasks   StudyFolderTask[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@map("study_folders")
}

model StudyFolderCourse {
  folderId String
  courseId String

  folder StudyFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([folderId, courseId])
  @@index([courseId])
  @@map("study_folder_courses")
}

model StudyFolderTask {
  folderId String
  taskId   String

  folder StudyFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([folderId, taskId])
  @@index([taskId])
  @@map("study_folder_tasks")
}

model CourseImportBatch {
  id               String   @id @default(uuid())
  userId           String
  requestId        String
  payloadHash      String
  status           String   @default("applying")
  targetSemesterId String?
  duplicatePolicy  String   @default("skip")
  source           Json?
  result           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@map("course_import_batches")
}

model CourseNote {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("course_notes")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  channel   String   @default("web")
  endpoint  String
  p256dh    String?
  auth      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  userId         String
  sourceType     String
  sourceId       String
  subscriptionId String
  deliveryKey    String   @unique
  scheduledFor   DateTime
  deliveredAt    DateTime @default(now())
  channel        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliveredAt])
  @@index([sourceType, sourceId])
  @@map("notification_deliveries")
}

model GoogleToken {
  id           String    @id @default(uuid())
  userId       String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  googleEmail  String?
  calendarId   String?   @default("primary")
  syncToken    String?
  lastSyncAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("google_tokens")
}

model NicknameSignupRateLimit {
  requestKey      String
  windowStartedAt DateTime @db.Timestamptz(6)
  attemptCount    Int      @default(1)

  @@id([requestKey, windowStartedAt])
  @@map("nickname_signup_rate_limits")
}
