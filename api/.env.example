# === 必需 ===
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sparkflow?schema=public"
# === API 端口 ===
PORT=3001

# === 认证（本地开发留空则跳过） ===
API_KEY="dev-local-key-change-in-production"

# === CORS（本地开发默认 localhost） ===
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# === 可选：AI / Bot ===
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
WECHAT_BOT_TOKEN=""

# === Google Calendar 同步 ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/auth/callback"
TOKEN_ENCRYPTION_KEY=""  # 32 字节随机 hex 字符串（64 个 hex 字符），用于加密 token
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
