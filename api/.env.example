# === 必需 ===
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sparkflow?schema=public"
# === API 端口 ===
PORT=3001

# === CORS（本地开发默认 localhost） ===
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# === 可选：AI / Bot ===
# Phase 15 M2 默认使用 OpenAI-compatible Chat Completions。
# AI_PROVIDER 可选 openai / deepseek；也可通过 AI_BASE_URL + AI_API_KEY 接其它兼容服务。
AI_PROVIDER="openai"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
WECHAT_BOT_TOKEN=""

# === 可选：AI 规划联网研究 ===
# SparkFlow 只调用由服务端管理员配置的 SearXNG，不接受用户提供搜索服务 URL。
# 例如同机 Docker 网络：http://searxng:8080
# 或反向代理地址：https://search.example.com
SEARXNG_BASE_URL=""

# === 可选：AI 规划语音转写 ===
# 千问 qwen3-asr-flash 使用 OpenAI-compatible chat/completions + input_audio。
# 若 STT_BASE_URL / STT_API_KEY 留空，将回退到 AI_BASE_URL / AI_API_KEY。
STT_BASE_URL=""
STT_API_KEY=""
STT_MODEL="qwen3-asr-flash"


# === 多模态随手记私有附件 ===
# 文件不会公开静态托管；客户端通过带会话认证的 API 读取。
# Docker/生产环境请把该目录挂载到持久化磁盘。
INSPIRATION_UPLOAD_DIR="./data/inspiration-attachments"

# === 课程 WebDAV（逗号分隔的精确源，包含非默认端口） ===
WEBDAV_ALLOWED_ORIGINS=""
WEBDAV_URL=""
WEBDAV_USERNAME=""
WEBDAV_PASSWORD=""
# 例如允许 https://dav.example.com，并将 URL 指向已创建的 /dav/SparkFlow/ 目录。
# 仅允许受信任的 WebDAV 源；不得向不可信源发送 WebDAV 账号。

# === Google Calendar 同步 ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/auth/callback"
TOKEN_ENCRYPTION_KEY=""  # 32 字节随机 hex 字符串（64 个 hex 字符），用于加密 token
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
