# ── API 配置 ──
VITE_API_BASE_URL=
# Supabase 项目 URL 与 publishable key（可公开，仅用于客户端）
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 旧请求参数兼容值；后端始终以 access token 的 sub 为准
VITE_DEFAULT_USER_ID=default

# ── Capacitor APP 专用（PWA 模式忽略，走 Vite proxy） ──
# APK 内没有 proxy，需填写后端完整地址：
# VITE_API_BASE_URL=http://192.168.x.x:3001
# 生产环境建议用你的 Render 域名：
# VITE_API_BASE_URL=https://sparkflow-api.onrender.com
